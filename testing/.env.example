# Base URL the API tests run against. Munafa has no dedicated backend --
# the app calls Yahoo Finance directly through a rewrite proxy, so this
# should point at a deployment that serves /api/yahoo/* (Vercel prod,
# a preview deployment, or `vite preview` locally).
MUNAFA_BASE_URL=https://munafa-io.vercel.app

# Per-request timeout (seconds) before a call is treated as failed.
MUNAFA_REQUEST_TIMEOUT=10
